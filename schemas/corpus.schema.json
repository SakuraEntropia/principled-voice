{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://principled-voice.local/schemas/corpus.schema.json",
  "title": "Principled Voice local corpus rights registry",
  "description": "data/corpus.json: corpus-level metadata plus the license and recording-authorization records referenced by manifest clips. Licenses (copyright in the recording/work) and authorizations (performer/voice consent) are separate and both are required before a clip can be 'cleared'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "received_on", "licenses", "authorizations"],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "title": { "type": "string" },
    "received_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "steward": {
      "type": "string",
      "description": "Who holds the files locally; no names of speakers are required here."
    },
    "notes": { "type": "string" },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["license_id", "name", "grantor", "scope"],
        "properties": {
          "license_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1 },
          "spdx": {
            "type": ["string", "null"],
            "description": "SPDX identifier if a standard license applies; null for a custom bilateral license."
          },
          "grantor": {
            "type": "string",
            "minLength": 1,
            "description": "Person or entity granting rights, with authority stated."
          },
          "granted_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "recording",
                "model_training",
                "synthesis",
                "voice_cloning",
                "commercial",
                "broadcast",
                "animation_production",
                "redistribution"
              ]
            }
          },
          "territory": { "type": ["string", "null"] },
          "expires_on": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "attribution_required": { "type": ["boolean", "null"] },
          "model_release_allowed": { "type": ["boolean", "null"] },
          "redistribution_allowed": { "type": ["boolean", "null"] },
          "document_path": {
            "type": ["string", "null"],
            "description": "Local path under data/rights/. Never committed or uploaded."
          },
          "document_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "restrictions": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consent_id", "signer_role", "signed_on", "scope"],
        "properties": {
          "consent_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "signer_role": {
            "enum": ["speaker", "guardian", "rights_holder", "licensee", "other"],
            "description": "Who signed. A licensee signature alone is not speaker consent."
          },
          "signed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "recording",
                "model_training",
                "synthesis",
                "voice_cloning",
                "commercial",
                "broadcast",
                "animation_production",
                "redistribution"
              ]
            }
          },
          "valid_until": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "withdrawal_terms": { "type": ["string", "null"] },
          "minors_involved": { "type": ["boolean", "null"] },
          "compensation_terms": { "type": ["string", "null"] },
          "storage_restrictions": { "type": ["string", "null"] },
          "document_path": { "type": ["string", "null"] },
          "document_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
